{
	"compilerOptions": {
		"module": "preserve",
		"target": "ES2022",
		"useDefineForClassFields": true,
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"types": ["vitest/globals", "vite/client", "node"],
		"declaration": true,
		"declarationMap": true,
		"skipLibCheck": true,
		// Resolves "#src/*" to the source while this package is built; see the
		// "imports" field of the package manifest.
		"customConditions": ["oci-client-source"],

		/* Bundler mode */
		"allowSyntheticDefaultImports": true,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		"moduleDetection": "force",
		"noEmit": true,

		/* Linting */
		"strict": true,
		"noUnusedLocals": true,
		"noFallthroughCasesInSwitch": true
	},
	"include": ["src"],
	"references": [{ "path": "./tsconfig.node.json" }]
}
