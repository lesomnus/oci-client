{
	"name": "@lesomnus/oci-client",
	"version": "1.0.2",
	"description": "Client implementation of OCI Distribution for Web",
	"keywords": [
		"oci",
		"oci-distribution",
		"registry",
		"container",
		"docker",
		"helm",
		"browser"
	],
	"author": {
		"name": "Seunghyun Hwang",
		"email": "lesomnus@gmail.com"
	},
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/lesomnus/oci-client.git"
	},
	"bugs": {
		"url": "https://github.com/lesomnus/oci-client/issues"
	},
	"homepage": "https://github.com/lesomnus/oci-client#readme",
	"engines": {
		"node": ">=22"
	},
	"type": "module",
	"sideEffects": false,
	"main": "./dist/main.cjs",
	"module": "./dist/main.js",
	"types": "./dist/index.d.ts",
	"typesVersions": {
		"*": {
			"media-types": [
				"./dist/media-types/index.d.ts"
			]
		}
	},
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/main.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/main.cjs"
			}
		},
		"./media-types": {
			"import": {
				"types": "./dist/media-types/index.d.ts",
				"default": "./dist/media-types.js"
			},
			"require": {
				"types": "./dist/media-types/index.d.cts",
				"default": "./dist/media-types.cjs"
			}
		}
	},
	"imports": {
		"#src/media-types": "./src/media-types/index.ts",
		"#src/testutils": "./src/testutils/index.ts",
		"#src/*": "./src/*.ts"
	},
	"files": [
		"dist",
		"src",
		"!src/**/*.test.ts",
		"!src/testutils"
	],
	"scripts": {
		"build": "tsc && vite build",
		"check:package": "attw --pack .",
		"prepare": "npm run build",
		"test": "vitest",
		"test:ui": "vitest --ui",
		"check": "biome check --write ."
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "0.18.5",
		"@biomejs/biome": "2.5.12",
		"@types/node": "^26.4.1",
		"@typescript/typescript6": "^6.0.2",
		"@vitest/browser": "^5.0.0",
		"@vitest/browser-playwright": "^5.0.0",
		"@vitest/coverage-istanbul": "^5.0.0",
		"@vitest/ui": "^5.0.0",
		"hash-wasm": "^4.12.0",
		"playwright": "^1.62.1",
		"typescript": "^7.0.2",
		"vite": "^8.2.2",
		"vite-plugin-dts": "^5.1.0",
		"vitest": "^5.0.0",
		"zx": "^8.8.5"
	}
}
